{
  "name": "yolov8-seg-onnxruntime-web",
  "homepage": "https://hyuto.github.io/yolov8-seg-onnxruntime-web/",
  "version": "0.1.0",
  "main": "main.js",
  "dependencies": {
    "@techstark/opencv-js": "4.5.5-release.2",
    "onnxruntime-node": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "build": "webpack --mode production && electron-builder",
    "webpack": "webpack --mode development",
    "dev": "webpack --mode development --watch",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "author": {
    "name": "Wahyu Setianto",
    "url": "https://github.com/Hyuto"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyuto/yolov8-seg-onnxruntime-web.git"
  },
  "bugs": {
    "url": "https://github.com/Hyuto/yolov8-seg-onnxruntime-web/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "gh-pages": "^4.0.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.yolov8.seg",
    "files": [
      "**/*",
      "public/**/*",
      "src/**/*"
    ],
    "directories": {
      "buildResources": "public"
    }
  }
}
