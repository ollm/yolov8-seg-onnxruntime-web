{
  "name": "yolov8-seg-onnxruntime-web",
  "homepage": "https://hyuto.github.io/yolov8-seg-onnxruntime-web/",
  "version": "0.1.0",
  "main": "main.js",
  "dependencies": {
    "@techstark/opencv-js": "4.5.5-release.2",
    "onnxruntime-node": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "canvas": "^2.11.2"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "concurrently \"npm run start\"",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "author": {
    "name": "Wahyu Setianto",
    "url": "https://github.com/Hyuto"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyuto/yolov8-seg-onnxruntime-web.git"
  },
  "bugs": {
    "url": "https://github.com/Hyuto/yolov8-seg-onnxruntime-web/issues"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "gh-pages": "^4.0.0"
  },
  "build": {
    "appId": "com.yolov8.seg",
    "files": [
      "**/*",
      "public/**/*",
      "src/**/*"
    ],
    "directories": {
      "buildResources": "public"
    }
  }
}
